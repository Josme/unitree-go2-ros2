<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

    <xacro:property name="M_PI" value="3.14159"/> 
    <xacro:property name="laser_min_range" value="0.1"/>
    <xacro:property name="laser_max_range" value="200.0"/>
    <xacro:property name="samples" value="24000"/>
    <xacro:property name="resolution" value="0.002"/>
    <xacro:property name="noise_mean" value="0.0"/>
    <xacro:property name="noise_stddev" value="0.01"/>


    <xacro:property name="mass" value="0.22" />
    <xacro:property name="length" value="0.05" /> 
    <xacro:property name="width" value="0.05" />  
    <xacro:property name="height" value="0.02" /> 

  <xacro:macro name="mid360" params="name:='' parent:= 'base_link' topic:='mid360' downsample:='1' visualize:='true' *origin ">

    <link name="${name}_frame">
      <xacro:if value="${visualize}">
        <visual>
            <origin rpy="0 0 1.57" xyz="0 0 0"/>
            <geometry>
                <mesh filename="file://$(find go2_description)/meshes/livox_mid360.dae"/>
            </geometry>
        </visual>
        
        <collision>
        <origin xyz="0 0 0" rpy="0 0 1.57" /> 
            <geometry> 
              <mesh filename="file://$(find go2_description)/meshes/livox_mid360.dae"/>
            </geometry>
        </collision>

        <inertial>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <mass value="${mass}"/>
          <inertia 
              ixx="${(mass/12) * (width**2 + height**2)}"
              ixy="0.0"
              ixz="0.0"
              iyy="${(mass/12) * (length**2 + height**2)}"
              iyz="0.0"
              izz="${(mass/12) * (length**2 + width**2)}"/>
        </inertial>
      </xacro:if>
    </link>

    <joint name="${name}_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${name}_frame"/>
      <xacro:insert_block name="origin"/>
    </joint>

    <link name="${name}_imu_link">
    </link>

    <joint name="${name}_imu_joint" type="fixed">
        <origin rpy="0 0 0" xyz="0.0 0 0"/>
        <parent link="${name}_frame"/>
        <child link="${name}_imu_link"/>
    </joint>

    <gazebo reference="${name}_frame">
      <sensor type="ray" name="${name}_frame">
        <pose>0 0 0 0 0 0</pose>
        <visualize>true</visualize>
        <update_rate>10</update_rate>
        <!-- This ray plgin is only for visualization. -->
        <plugin name="${name}_plugin" filename="libros2_livox.so">
			<ray>
			  <scan>
				<horizontal>
				<samples>100</samples>
				<resolution>1</resolution>
				<min_angle>${0}</min_angle>
				<max_angle>${2*M_PI}</max_angle>
				</horizontal>
				<vertical>
				<samples>360</samples>
				<resolution>1</resolution>
                <min_angle>${-55.22/180*pi}</min_angle>
                <max_angle>${7.22/180*pi}</max_angle>
				</vertical>
			  </scan>
			  <range>
				<min>${laser_min_range}</min>
				<max>${laser_max_range}</max>
				<resolution>${resolution}</resolution>
			  </range>
			  <noise>
				<type>gaussian</type>
				<mean>${noise_mean}</mean>
				<stddev>${noise_stddev}</stddev>
			  </noise>
			</ray>
          <visualize>false</visualize>
		  <samples>${samples}</samples>
		  <downsample>${downsample}</downsample>
		  <csv_file_name>$(find ros2_livox_simulation)/scan_mode/mid360.csv</csv_file_name>
		  <topic>${topic}</topic>
        </plugin>
      </sensor>
    </gazebo>

    <gazebo reference="${name}_imu_link">
        <gravity>true</gravity>
        <sensor name="${name}imu_sensor" type="imu">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <visualize>true</visualize>
        <topic>__default_topic__</topic>
        <pose>0 0 0 0 0 0</pose>
        <plugin filename="libgazebo_ros_imu_sensor.so" name="${name}_imu_plugin">
            <ros>
            <namespace>livox</namespace>
            <remapping>${name}_imu_plugin/out:=/${name}/imu</remapping>
            </ros>
            <topicName>imu</topicName>
            <bodyName>${name}_imu_link</bodyName>
            <updateRateHZ>100.0</updateRateHZ>
            <gaussianNoise>0.0001</gaussianNoise>
            <xyzOffset>0 0 0</xyzOffset>
            <rpyOffset>0 0 0</rpyOffset>
            <frame_name>${name}_imu_link</frame_name>
            <initial_orientation_as_reference>false</initial_orientation_as_reference>
        </plugin>
        </sensor>
    </gazebo>
  </xacro:macro>

</robot>